        '\n' +
        '        // Verify homepage is active\n' +
        `        const contentFeed = await $('//androidx.recyclerview.widget.RecyclerView[@resource-id="com.cnn.mobile.android.phone:id/recycler_view"]')\n` +
        '        await expect(contentFeed).toBeDisplayed()\n' +
