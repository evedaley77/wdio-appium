        '                await element.click()\n' +
        '                console.log(`[TC-001] Screen element displayed: ${name}`)\n' +
        '                return true\n' +
        '            }\n' +
        '\n' +
        `            await clickWhenReady('//android.widget.Button[@text="Next"] | //android.widget.TextView[@text="Next"] | //*[@text="Next"]', 'Next')\n` +
        '\n' +
        '            // Save and continue past alerts screen\n' +
        `            await clickWhenReady('//android.widget.Button[@text="Save and continue"] | //android.widget.TextView[@text="Save and continue"] | //*[@text="Save and continue"]', 'Save and continue', 10000).catch(() => {})\n` +
        '\n' +
        '            // Allow notifications if prompted\n' +
        `            await clickWhenReady('//android.widget.Button[@resource-id="com.android.permissioncontroller:id/permission_allow_button"]', 'Allow notifications', 10000).catch(() => {})\n` +
        '\n' +
        '            // Agree to legal terms when the screen is displayed.\n' +
        `            await clickWhenReady('//android.widget.Button[@text="AGREE"] | //android.widget.TextView[@text="AGREE"] | //*[@text="AGREE"]', 'AGREE', 10000).catch(() => {})\n` +
        '        }\n' +
        '\n' +
        '        // Wait for a homepage surface after onboarding and network loading.\n' +
        '        await browser.waitUntil(async () => Boolean(await findDisplayedHomepage()), {\n' +
        '            timeout: 30000,\n' +
