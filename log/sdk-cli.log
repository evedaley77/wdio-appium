      code: 'async () => {\n' +
        '\n' +
        '        // Verify homepage is active\n' +
        `        const contentFeed = await $('//androidx.recyclerview.widget.RecyclerView[@resource-id="com.cnn.mobile.android.phone:id/recycler_view"]')\n` +
        '        await expect(contentFeed).toBeDisplayed()\n' +
        '\n' +
        '        // Click on the first available story headline\n' +
        `        const firstHeadline = await $('//android.widget.TextView[@resource-id="com.cnn.mobile.android.phone:id/headline"]')\n` +
        '        await expect(firstHeadline).toBeDisplayed()\n' +
        '        await firstHeadline.click()\n' +
        '        await browser.pause(4000)\n' +
        '\n' +
        '        // Verify navigation to article page — article content container should appear\n' +
        `        const articleContainer = await $('//android.widget.ScrollView[@resource-id="com.cnn.mobile.android.phone:id/article_scroll_view"]')\n` +
        '        await expect(articleContainer).toBeDisplayed()\n' +
        '\n' +
        '        // Validate analytics click/tap event in WEBVIEW\n' +
        '        const contexts = await browser.getContexts()\n' +
        "        const webview = contexts.find(ctx => ctx.startsWith('WEBVIEW'))\n" +
        '        if (webview) {\n' +
        '            await browser.switchContext(webview)\n' +
        '            const analyticsEvents = await browser.execute(() => window.__wdioAnalyticsEvents || [])\n' +
        "            console.log('[TC-003] Article pageview analytics:', JSON.stringify(analyticsEvents.slice(0, 5)))\n" +
        "            await browser.switchContext('NATIVE_APP')\n" +
        '        }\n' +
        '\n' +
        '        // Press back button to return to homepage\n' +
        '        await driver.back()\n' +
        '        await browser.pause(3000)\n' +
        '\n' +
        '        // Verify user is back on homepage\n' +
        '        await expect(contentFeed).toBeDisplayed()\n' +
        '\n' +
        "        console.log('[TC-003] Homepage navigation to article and back verified')\n" +
        '    }'
    },
    identifier: 'should navigate from homepage to article and back',
    scope: 'TC-003: Homepage Navigation - should navigate from homepage to article and back',
