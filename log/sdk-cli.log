    name: 'should load the CNN homepage and fire a Pageview analytics event',
    body: {
      lang: 'ecmascript',
      code: 'async () => {\n' +
        '        // Wait for app to fully launch past splash screen.\n' +
        '        await browser.pause(5000)\n' +
        '\n' +
        `        const contentFeed = await $('//androidx.recyclerview.widget.RecyclerView[@resource-id="com.cnn.mobile.android.phone:id/recycler_view"]')\n` +
        `        const mainContainer = await $('//android.widget.FrameLayout[@resource-id="com.cnn.mobile.android.phone:id/container"]')\n` +
        "        const homeTab = await $('~Home')\n" +
        `        const agreeSelector = '//android.widget.Button[@text="AGREE"] | //android.widget.TextView[@text="AGREE"] | //*[@text="AGREE"]'\n` +
        '        const clickWhenReady = async (selector, timeout = 15000) => {\n' +
        '            const element = await $(selector)\n' +
        '            await browser.waitUntil(async () => {\n' +
        '                return await element.isDisplayed().catch(() => false) &&\n' +
        '                    await element.isEnabled().catch(() => false)\n' +
        '            }, { timeout, interval: 500 })\n' +
        '            await element.click()\n' +
        '        }\n' +
        '\n' +
        '        // Dismiss onboarding if present (edition selection screen)\n' +
        `        const editionScreen = await $('//android.widget.TextView[@text="U.S. Edition"]')\n` +
        '        const editionVisible = await editionScreen.isDisplayed().catch(() => false)\n' +
        '        if (editionVisible) {\n' +
        '            await clickWhenReady(\n' +
        `                '//android.widget.Button[@text="Next"] | //android.widget.TextView[@text="Next"] | //*[@text="Next"]'\n` +
        '            )\n' +
        '            await browser.pause(5000)\n' +
        '\n' +
        '            // Save and continue past alerts screen\n' +
        '            await clickWhenReady(\n' +
        `                '//android.widget.Button[@text="Save and continue"] | //android.widget.TextView[@text="Save and continue"] | //*[@text="Save and continue"]',\n` +
        '                10000\n' +
        '            ).catch(() => {})\n' +
        '            await browser.pause(3000)\n' +
        '\n' +
        '            // Allow notifications if prompted\n' +
        '            await clickWhenReady(\n' +
        `                '//android.widget.Button[@resource-id="com.android.permissioncontroller:id/permission_allow_button"]',\n` +
        '                10000\n' +
        '            ).catch(() => {})\n' +
        '            await browser.pause(3000)\n' +
        '        }\n' +
        '\n' +
        '        // Legal terms can appear after a delayed permission screen or on their own.\n' +
        '        await browser.waitUntil(async () => {\n' +
        '            const homeVisible = await homeTab.isDisplayed().catch(() => false)\n' +
        '            const agreeVisible = await $(agreeSelector).isDisplayed().catch(() => false)\n' +
        '            return homeVisible || agreeVisible\n' +
        "        }, { timeout: 30000, interval: 1000, timeoutMsg: 'CNN onboarding did not reach Home or Legal Terms within 30s' })\n" +
        '\n' +
        '        if (!await homeTab.isDisplayed().catch(() => false)) {\n' +
        '            await clickWhenReady(agreeSelector, 15000)\n' +
        '            await browser.pause(5000)\n' +
        '        }\n' +
        '\n' +
        '        // The package is present during onboarding, so wait for actual homepage UI.\n' +
        '        await browser.waitUntil(async () => {\n' +
        '            const homeVisible = await homeTab.isDisplayed().catch(() => false)\n' +
        '            if (!homeVisible) return false\n' +
        '\n' +
        "            const source = await driver.getPageSource().catch(() => '')\n" +
        '            const homeLabelVisible = /content-desc="Home"|text="Home"/.test(source)\n' +
        '            const feedVisible = await contentFeed.isDisplayed().catch(() => false)\n' +
        '            const containerVisible = await mainContainer.isDisplayed().catch(() => false)\n' +
        '            return homeLabelVisible && (feedVisible || containerVisible)\n' +
        '        }, {\n' +
        '            timeout: 60000,\n' +
        '            interval: 1000,\n' +
        "            timeoutMsg: 'CNN homepage Home tab and content surface did not load within 60s'\n" +
        '        })\n' +
        '\n' +
        '        // Verify the homepage surfaces remain visible after initial rendering.\n' +
        `        const bottomNav = await $('//*[@resource-id="com.cnn.mobile.android.phone:id/bottom_navigation"]')\n` +
        '        const bottomNavVisible = await bottomNav.isDisplayed().catch(() => false)\n' +
        "        console.log('[TC-001] Bottom nav visible:', bottomNavVisible)\n" +
        '\n' +
        '        await expect(homeTab).toBeDisplayed()\n' +
        '        const homepageSurfaceVisible = await mainContainer.isDisplayed().catch(() => false) ||\n' +
        '            await contentFeed.isDisplayed().catch(() => false)\n' +
        '        expect(homepageSurfaceVisible).toBe(true)\n' +
        '\n' +
        '        const pageSource = await driver.getPageSource()\n' +
        "        expect(pageSource).toContain('com.cnn.mobile.android.phone')\n" +
        '\n' +
        '        // Inspect only CNN WebViews; BrowserStack may expose unrelated app contexts.\n' +
        '        const contexts = await browser.getContexts()\n' +
        "        const webview = contexts.find(context => context.startsWith('WEBVIEW_com.cnn'))\n" +
        '        if (webview) {\n' +
        '            try {\n' +
        '                await browser.switchContext(webview)\n' +
        '                const analyticsEvents = await browser.execute(() => {\n' +
        '                    return window.__wdioAnalyticsEvents || []\n' +
        '                })\n' +
        "                console.log('[TC-001] Analytics events captured:', JSON.stringify(analyticsEvents.slice(0, 5)))\n" +
        '            } finally {\n' +
        "                await browser.switchContext('NATIVE_APP')\n" +
        '            }\n' +
        '        }\n' +
        '\n' +
        "        console.log('[TC-001] Homepage loaded successfully')\n" +
        '\n' +
        '        // Open Settings from the bottom navigation after the homepage is ready.\n' +
        "        const settingsTab = await $('~Settings')\n" +
        '        await settingsTab.waitForDisplayed({\n' +
        '            timeout: 15000,\n' +
        "            timeoutMsg: 'Settings option was not displayed in the bottom navigation'\n" +
        '        })\n' +
        '        await settingsTab.click()\n' +
        '\n' +
        '        // Open the subscription flow from Settings.\n' +
        '        const subscribeOption = await $(\n' +
        `            '//*[@text="Subscribe"] | ' +\n` +
        `            '//*[@text="Subscribe Now"] | ' +\n` +
        `            '//*[contains(@text,"Subscribe")]'\n` +
        '        )\n' +
        '        await subscribeOption.waitForDisplayed({\n' +
        '            timeout: 20000,\n' +
        "            timeoutMsg: 'Subscribe option was not displayed in Settings'\n" +
        '        })\n' +
        '        await subscribeOption.click()\n' +
        '\n' +
        '        // Select the first recognizable plan option shown by the subscription screen.\n' +
        '        const planOption = await $(\n' +
        `            '//*[@text="Monthly"] | ' +\n` +
        `            '//*[@text="Annual"] | ' +\n` +
        `            '//*[@text="Choose a plan"] | ' +\n` +
        `            '//*[contains(@text,"Monthly")] | ' +\n` +
        `            '//*[contains(@text,"Annual")]'\n` +
        '        )\n' +
        '        await planOption.waitForDisplayed({\n' +
        '            timeout: 30000,\n' +
        "            timeoutMsg: 'No subscription plan option was displayed after selecting Subscribe'\n" +
        '        })\n' +
        '        await planOption.click()\n' +
        "        console.log('[TC-001] Settings opened, Subscribe selected, and a plan option clicked')\n" +
        '    }'
    },
    identifier: 'should load the CNN homepage and fire a Pageview analytics event',
