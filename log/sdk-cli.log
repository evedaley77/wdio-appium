    name: 'should load the CNN homepage and fire a Pageview analytics event',
    body: {
      lang: 'ecmascript',
      code: 'async () => {\n' +
        '        // Wait for app to fully launch past splash screen\n' +
        '        await browser.pause(10000)\n' +
        '\n' +
        '        // Dismiss onboarding if present (edition selection screen)\n' +
        `        const editionScreen = await $('//android.widget.TextView[@text="U.S. Edition"]')\n` +
        '        const editionVisible = await editionScreen.isDisplayed().catch(() => false)\n' +
        '        if (editionVisible) {\n' +
        `            await $('//android.widget.TextView[@text="Next"]').click()\n` +
        '            await browser.pause(5000)\n' +
        '\n' +
        '            // Save and continue past alerts screen\n' +
        `            const saveBtn = await $('//android.widget.TextView[@text="Save and continue"]')\n` +
        '            const saveBtnVisible = await saveBtn.isDisplayed().catch(() => false)\n' +
        '            if (saveBtnVisible) {\n' +
        '                await saveBtn.click()\n' +
        '                await browser.pause(5000)\n' +
        '            }\n' +
        '\n' +
        '            // Allow notifications if prompted\n' +
        `            const allowBtn = await $('//android.widget.Button[@resource-id="com.android.permissioncontroller:id/permission_allow_button"]')\n` +
        '            const allowVisible = await allowBtn.isDisplayed().catch(() => false)\n' +
        '            if (allowVisible) {\n' +
        '                await allowBtn.click()\n' +
        '                await browser.pause(3000)\n' +
        '            }\n' +
        '\n' +
        '            // Agree to legal terms\n' +
        `            const agreeBtn = await $('//android.widget.TextView[@text="AGREE"]')\n` +
        '            const agreeVisible = await agreeBtn.isDisplayed().catch(() => false)\n' +
        '            if (agreeVisible) {\n' +
        '                await agreeBtn.click()\n' +
        '                await browser.pause(8000)\n' +
        '            }\n' +
        '        }\n' +
        '\n' +
        '        // Verify homepage is loaded using the app package in the native page source.\n' +
        '        await browser.waitUntil(async () => {\n' +
        '            const source = await driver.getPageSource()\n' +
        "            return source.includes('com.cnn.mobile.android.phone')\n" +
        "        }, { timeout: 30000, timeoutMsg: 'CNN app did not load within 30s' })\n" +
        '\n' +
        '        // Verify the bottom navigation bar is present when available.\n' +
        `        const bottomNav = await $('//*[@resource-id="com.cnn.mobile.android.phone:id/bottom_navigation"]')\n` +
        '        const bottomNavVisible = await bottomNav.isDisplayed().catch(() => false)\n' +
        "        console.log('[TC-001] Bottom nav visible:', bottomNavVisible)\n" +
        '\n' +
        '        // Fallback: verify any CNN content is on screen\n' +
        '        const pageSource = await driver.getPageSource()\n' +
        "        expect(pageSource).toContain('com.cnn.mobile.android.phone')\n" +
        '\n' +
        '        // Switch to WEBVIEW context to validate analytics events when available.\n' +
        '        const contexts = await browser.getContexts()\n' +
        "        const webview = contexts.find(context => context.startsWith('WEBVIEW'))\n" +
        '        if (webview) {\n' +
        '            await browser.switchContext(webview)\n' +
        '\n' +
        '            const analyticsEvents = await browser.execute(() => {\n' +
        '                return window.__wdioAnalyticsEvents || []\n' +
        '            })\n' +
        '\n' +
        '            const pageviewEvent = analyticsEvents.find(event =>\n' +
        "                event.url && (event.url.includes('pageview') || event.url.includes('stellar'))\n" +
        '            )\n' +
        '\n' +
        "            console.log('[TC-001] Analytics events captured:', JSON.stringify(analyticsEvents.slice(0, 5)))\n" +
        "            await browser.switchContext('NATIVE_APP')\n" +
        '        }\n' +
        '\n' +
        "        console.log('[TC-001] Homepage loaded successfully')\n" +
        '    }'
    },
    identifier: 'should load the CNN homepage and fire a Pageview analytics event',
    scope: 'TC-001: Homepage Load - should load the CNN homepage and fire a Pageview analytics event',
