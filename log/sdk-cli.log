        code: 'async function(){this.timeout(9e4);const backBtn=await $(SEL.backBtn);const backVisible=await backBtn.isDisplayed().catch(()=>false);if(backVisible){await backBtn.click()}else{await browser.back()}const homeTab=await $(SEL.homeTab);await homeTab.waitForExist({timeout:3e4});const allEvents=await collectFromWebview();const adobeEvents=allEvents.filter(e=>/omtrdc\\.net|2o7\\.net|adobe\\.com\\/b\\/ss/i.test(e.url||""));const zionEvents=allEvents.filter(e=>/zion/i.test(e.url||""));const snowplowEvents=allEvents.filter(e=>/snowplowanalytics\\.snowplow\\/tp2/i.test(e.url||""));console.log(`[TC-019][10] Adobe: ${adobeEvents.length} | Zion: ${zionEvents.length} | Snowplow: ${snowplowEvents.length}`);const adobeFired=adobeEvents.length>0;const zionOrSnowplowFired=zionEvents.length>0||snowplowEvents.length>0;if(adobeFired&&zionOrSnowplowFired){console.log("[TC-019][10] \\u2705 Adobe and Zion/Snowplow both fired \\u2014 data consistency confirmed")}else if(adobeFired){console.log("[TC-019][10] \\u2139\\uFE0F  Adobe fired; Zion/Snowplow not captured in WebView")}else if(zionOrSnowplowFired){console.log("[TC-019][10] \\u2139\\uFE0F  Zion/Snowplow fired; Adobe not captured in WebView")}else{console.log("[TC-019][10] \\u2139\\uFE0F  No analytics beacons captured in WebView \\u2014 may fire via native layer or HAR")}if(adobeEvents.length>0){console.log(`[TC-019][10] Adobe sample: ${adobeEvents[0].url.substring(0,150)}`)}if(zionEvents.length>0){console.log(`[TC-019][10] Zion sample : ${zionEvents[0].url.substring(0,150)}`)}await homeTab.waitForExist({timeout:1e4});console.log("[TC-019][10] \\u2705 Full analytics journey completed successfully")}'
