        "                console.log('[TC-001] Analytics events captured:', JSON.stringify(analyticsEvents.slice(0, 5)))\n" +
        '            } finally {\n' +
        "                await browser.switchContext('NATIVE_APP')\n" +
        '            }\n' +
        '        }\n' +
        '\n' +
        "        console.log('[TC-001] Homepage loaded successfully')\n" +
        '\n' +
        '        // Open Settings from the bottom navigation after the homepage is ready.\n' +
        "        const settingsTab = await $('~Settings')\n" +
        '        await settingsTab.waitForDisplayed({\n' +
        '            timeout: 15000,\n' +
        "            timeoutMsg: 'Settings option was not displayed in the bottom navigation'\n" +
        '        })\n' +
        '        await settingsTab.click()\n' +
        '\n' +
        '        // Open the subscription flow from Settings.\n' +
        '        const subscribeOption = await $(\n' +
