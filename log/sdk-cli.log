  event_type: 'TestRunStarted',
  test_run: {
    type: 'test',
    framework: 'WebdriverIO-mocha',
    uuid: '221f472a-2444-48a9-bb65-e3bca74e6e94',
    name: 'should load a full article page with content and analytics',
    body: {
      lang: 'ecmascript',
      code: 'async () => {\n' +
        '\n' +
        '        // Verify homepage is loaded\n' +
        `        const contentFeed = await $('//androidx.recyclerview.widget.RecyclerView[@resource-id="com.cnn.mobile.android.phone:id/recycler_view"]')\n` +
        '        await expect(contentFeed).toBeDisplayed()\n' +
        '\n' +
        '        // Click on the first story headline\n' +
        `        const firstHeadline = await $('//android.widget.TextView[@resource-id="com.cnn.mobile.android.phone:id/headline"]')\n` +
        '        await expect(firstHeadline).toBeDisplayed()\n' +
        '        const headlineText = await firstHeadline.getText()\n' +
        "        console.log('[TC-005] Clicking headline:', headlineText)\n" +
        '        await firstHeadline.click()\n' +
        '        await browser.pause(5000)\n' +
        '\n' +
        '        // Verify article page loaded — article scroll view\n' +
        `        const articleScrollView = await $('//android.widget.ScrollView[@resource-id="com.cnn.mobile.android.phone:id/article_scroll_view"]')\n` +
        '        await expect(articleScrollView).toBeDisplayed()\n' +
        '\n' +
        '        // Verify article headline/title is displayed\n' +
        `        const articleTitle = await $('//android.widget.TextView[@resource-id="com.cnn.mobile.android.phone:id/article_headline"]')\n` +
        '        await expect(articleTitle).toBeDisplayed()\n' +
        '        const articleTitleText = await articleTitle.getText()\n' +
        "        console.log('[TC-005] Article title:', articleTitleText)\n" +
        '        expect(articleTitleText.length).toBeGreaterThan(0)\n' +
        '\n' +
        '        // Validate analytics in WEBVIEW context\n' +
        '        const contexts = await browser.getContexts()\n' +
        "        const webview = contexts.find(ctx => ctx.startsWith('WEBVIEW'))\n" +
        '        if (webview) {\n' +
        '            await browser.switchContext(webview)\n' +
        '\n' +
        '            const currentUrl = await browser.getUrl()\n' +
        "            console.log('[TC-005] Article URL:', currentUrl)\n" +
        "            expect(currentUrl).toContain('cnn.com')\n" +
        '\n' +
        '            const analyticsEvents = await browser.execute(() => window.__wdioAnalyticsEvents || [])\n' +
        "            console.log('[TC-005] Article analytics events:', JSON.stringify(analyticsEvents.slice(0, 5)))\n" +
        '\n' +
        '            // Validate article pageview event\n' +
        '            const pageviewEvent = analyticsEvents.find(e =>\n' +
        "                e.url && (e.url.includes('pageview') || e.url.includes('article'))\n" +
        '            )\n' +
        "            console.log('[TC-005] Pageview event:', pageviewEvent ? 'found' : 'not found in captured events')\n" +
        '\n' +
        "            await browser.switchContext('NATIVE_APP')\n" +
        '        }\n' +
        '\n' +
        "        console.log('[TC-005] Article page load verified')\n" +
        '    }'
    },
    identifier: 'should load a full article page with content and analytics',
    scope: 'TC-005: Article Page Load - should load a full article page with content and analytics',
    scopes: [ 'TC-005: Article Page Load' ],
