    name: 'should load the CNN homepage and fire a Pageview analytics event',
    body: {
      lang: 'ecmascript',
      code: 'async function () {\n' +
        '        this.timeout(120000)\n' +
        '\n' +
        '        const homepageSelectors = [\n' +
        `            { name: 'Homepage RecyclerView', selector: '//androidx.recyclerview.widget.RecyclerView[@resource-id="com.cnn.mobile.android.phone:id/recycler_view"]' },\n` +
        `            { name: 'Homepage container', selector: '//android.widget.FrameLayout[@resource-id="com.cnn.mobile.android.phone:id/container"]' },\n` +
        `            { name: 'Homepage bottom navigation', selector: '//android.widget.LinearLayout[@resource-id="com.cnn.mobile.android.phone:id/bottom_navigation"]' },\n` +
        "            { name: 'Homepage WebView', selector: '//android.webkit.WebView' },\n" +
        "            { name: 'Homepage ComposeView', selector: '//androidx.compose.ui.platform.ComposeView' }\n" +
        '        ]\n' +
        `        const editionScreen = await $('//android.widget.TextView[@text="U.S. Edition"]')\n` +
        '        const findDisplayedHomepage = async () => {\n' +
        '            for (const homepageSelector of homepageSelectors) {\n' +
        '                const element = await $(homepageSelector.selector)\n' +
        '                if (await element.isDisplayed().catch(() => false)) {\n' +
        '                    return { element, name: homepageSelector.name }\n' +
        '                }\n' +
        '            }\n' +
        '            return null\n' +
        '        }\n' +
        '\n' +
        '        // Wait for the app to leave the splash screen and expose either onboarding or the homepage.\n' +
        '        await browser.waitUntil(async () => {\n' +
        '            const onboardingVisible = await editionScreen.isDisplayed().catch(() => false)\n' +
        '            return onboardingVisible || Boolean(await findDisplayedHomepage())\n' +
        "        }, { timeout: 30000, timeoutMsg: 'CNN app did not leave the splash screen within 30s' })\n" +
        '\n' +
        '        // Dismiss onboarding if present (edition selection screen)\n' +
        '        const editionVisible = await editionScreen.isDisplayed().catch(() => false)\n' +
        '        if (editionVisible) {\n' +
        "            console.log('[TC-001] Screen displayed: U.S. Edition')\n" +
        `            const nextBtn = await $('//android.widget.TextView[@text="Next"]')\n` +
        '            await nextBtn.waitForDisplayed({\n' +
        '                timeout: 10000,\n' +
        "                timeoutMsg: 'CNN onboarding displayed, but the Next button was not available'\n" +
        '            })\n' +
        "            console.log('[TC-001] Screen element displayed: Next')\n" +
        '            await nextBtn.click()\n' +
        '\n' +
        '            // Save and continue past alerts screen\n' +
        `            const saveBtn = await $('//android.widget.TextView[@text="Save and continue"]')\n` +
        '            if (await saveBtn.waitForDisplayed({ timeout: 10000 }).then(() => true).catch(() => false)) {\n' +
        "                console.log('[TC-001] Screen element displayed: Save and continue')\n" +
        '                await saveBtn.click()\n' +
        '            }\n' +
        '\n' +
        '            // Allow notifications if prompted\n' +
        `            const allowBtn = await $('//android.widget.Button[@resource-id="com.android.permissioncontroller:id/permission_allow_button"]')\n` +
        '            if (await allowBtn.waitForDisplayed({ timeout: 10000 }).then(() => true).catch(() => false)) {\n' +
        "                console.log('[TC-001] Screen element displayed: Allow notifications')\n" +
        '                await allowBtn.click()\n' +
        '            }\n' +
        '\n' +
        '            // Agree to legal terms when the screen is displayed.\n' +
        '            const agreeBtn = await $(\n' +
        `                '//android.widget.TextView[@text="AGREE"] | ' +\n` +
        `                '//android.widget.Button[@text="AGREE"] | ' +\n` +
        `                '//*[@text="AGREE"]'\n` +
        '            )\n' +
        '            if (await agreeBtn.waitForDisplayed({ timeout: 10000 }).then(() => true).catch(() => false)) {\n' +
        "                console.log('[TC-001] Screen element displayed: AGREE')\n" +
        '                await agreeBtn.click()\n' +
        '            }\n' +
        '        }\n' +
        '\n' +
        '        // Wait for a homepage surface after onboarding and network loading.\n' +
        '        await browser.waitUntil(async () => Boolean(await findDisplayedHomepage()), {\n' +
        '            timeout: 30000,\n' +
        "            timeoutMsg: 'CNN homepage did not display within 30s'\n" +
        '        })\n' +
        '        const homepage = await findDisplayedHomepage()\n' +
        '        await expect(homepage.element).toBeDisplayed()\n' +
        '        console.log(`[TC-001] Screen displayed: ${homepage.name}`)\n' +
        '\n' +
        '        // Fallback: verify any CNN content is on screen\n' +
        '        const pageSource = await driver.getPageSource()\n' +
        "        expect(pageSource).toContain('com.cnn.mobile.android.phone')\n" +
        '\n' +
        '        // Keep the CNN homepage visible for review before the session closes.\n' +
        "        await browser.switchContext('NATIVE_APP')\n" +
        '        await browser.waitUntil(async () => Boolean(await findDisplayedHomepage()), {\n' +
        '            timeout: 10000,\n' +
        "            timeoutMsg: 'CNN homepage was no longer visible before the review pause'\n" +
        '        })\n' +
        '        const finalHomepage = await findDisplayedHomepage()\n' +
        '        console.log(`[TC-001] Screen displayed before review pause: ${finalHomepage.name}`)\n' +
        "        console.log('[TC-001] Waiting 30 seconds before closing the app')\n" +
        '        await browser.pause(30000)\n' +
        '\n' +
        "        console.log('[TC-001] Homepage loaded successfully')\n" +
        '    }'
    },
    identifier: 'should load the CNN homepage and fire a Pageview analytics event',
    scope: 'TC-001: Homepage Load - should load the CNN homepage and fire a Pageview analytics event',
