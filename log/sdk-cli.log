  event_type: 'TestRunStarted',
  test_run: {
    type: 'test',
    framework: 'WebdriverIO-mocha',
    uuid: '2dbf2097-ec0d-4016-940b-f3bd4f3c5525',
    name: 'should login successfully with valid credentials and fire LoginSuccessful event',
    body: {
      lang: 'ecmascript',
      code: 'async () => {\n' +
        "        const testEmail = process.env.CNN_TEST_EMAIL || 'test@example.com'\n" +
        "        const testPassword = process.env.CNN_TEST_PASSWORD || 'TestPassword123!'\n" +
        '\n' +
        '        // Navigate to profile/sign-in tab\n' +
        `        const profileTab = await $('//android.widget.TextView[@resource-id="com.cnn.mobile.android.phone:id/navigation_profile"]')\n` +
        '        if (await profileTab.isDisplayed().catch(() => false)) {\n' +
        '            await profileTab.click()\n' +
        '        } else {\n' +
        `            const navItems = await $$('//android.widget.FrameLayout[@resource-id="com.cnn.mobile.android.phone:id/navigation_bar_item_icon_view"]')\n` +
        '            if (navItems.length > 0) await navItems[navItems.length - 1].click()\n' +
        '        }\n' +
        '        await browser.pause(3000)\n' +
        '\n' +
        '        // Tap Sign In button\n' +
        `        const signInBtn = await $('//android.widget.TextView[@text="Sign In"]')\n` +
        '        if (await signInBtn.isDisplayed().catch(() => false)) {\n' +
        '            await signInBtn.click()\n' +
        '            await browser.pause(3000)\n' +
        '        }\n' +
        '\n' +
        '        // Login form is rendered in WEBVIEW\n' +
        '        const contexts = await browser.getContexts()\n' +
        "        const webview = contexts.find(ctx => ctx.startsWith('WEBVIEW'))\n" +
        '        if (webview) {\n' +
        '            await browser.switchContext(webview)\n' +
        '\n' +
        `            const emailInput = await $('input[type="email"]')\n` +
        '            await expect(emailInput).toBeDisplayed()\n' +
        '            await emailInput.setValue(testEmail)\n' +
        '\n' +
        `            const passwordInput = await $('input[type="password"]')\n` +
        '            await expect(passwordInput).toBeDisplayed()\n' +
        '            await passwordInput.setValue(testPassword)\n' +
        '\n' +
        `            const loginBtn = await $('button[type="submit"]')\n` +
        '            await loginBtn.click()\n' +
        '            await browser.pause(5000)\n' +
        '\n' +
        '            const currentUrl = await browser.getUrl()\n' +
        "            console.log('[TC-007] Post-login URL:', currentUrl)\n" +
        '\n' +
        '            const analyticsEvents = await browser.execute(() => window.__wdioAnalyticsEvents || [])\n' +
        "            console.log('[TC-007] Login analytics events:', JSON.stringify(analyticsEvents.slice(0, 5)))\n" +
        "            const loginEvent = analyticsEvents.find(e => e.url && (e.url.includes('login') || e.url.includes('LoginSuccessful')))\n" +
        "            console.log('[TC-007] LoginSuccessful event:', loginEvent ? 'found' : 'not found in captured events')\n" +
        '\n' +
        "            await browser.switchContext('NATIVE_APP')\n" +
        '        }\n' +
        '\n' +
        "        console.log('[TC-007] Login flow with valid credentials completed')\n" +
        '    }'
    },
    identifier: 'should login successfully with valid credentials and fire LoginSuccessful event',
    scope: 'TC-007: Login Flow (Valid User) - should login successfully with valid credentials and fire LoginSuccessful event',
    scopes: [ 'TC-007: Login Flow (Valid User)' ],
