sible=await homeTab.isDisplayed().catch(()=>false);const agreeVisible=await $(agreeSelector).isDisplayed().catch(()=>false);return homeVisible||agreeVisible},{timeout:3e4,interval:1e3,timeoutMsg:\"CNN onboarding did not reach Home or Legal Terms within 30s\"});if(!await homeTab.isDisplayed().catch(()=>false)){await clickWhenReady(agreeSelector,15e3);await browser.pause(5e3)}try{await browser.waitUntil(async()=>{const contentErrorVisible=await contentLoadError.isDisplayed().catch(()=>false);if(contentErrorVisible)return true;const homeVisible=await homeTab.isDisplayed().catch(()=>false);if(!homeVisible)return false;const source=await driver.getPageSource().catch(()=>\"\");const homeLabelVisible=/content-desc=\"Home\"|text=\"Home\"/.test(source);const feedVisible=await contentFeed.isDisplayed().catch(()=>false);const containerVisible=await mainContainer.isDisplayed().catch(()=>false);return homeLabelVisible&&(feedVisible||containerVisible)},{timeout:6e4,interval:1e3,timeoutMsg:\"CNN homepage Home tab and content surface did not load within 60s\"});if(await contentLoadError.isDisplayed().catch(()=>false)){throw new Error(\"CNN homepage displayed a content-load error\")}}catch(waitError){let source=\"\";let sourceError;try{source=await driver.getPageSource()}catch(error){sourceError=error.message}const homeVisible=await homeTab.isDisplayed().catch(()=>false);const homeLabelVisible=/content-desc=\"Home\"|text=\"Home\"/.test(source);const feedVisible=await contentFeed.isDisplayed().catch(()=>false);const containerVisible=await mainContainer.isDisplayed().catch(()=>false);const contentErrorVisible=await contentLoadError.isDisplayed().catch(()=>false);const timestamp=new Date().toISOString().replace(/[:.]/g,\"-\");const pageSourcePath=(0,import_node_path.join)(process.cwd(),\"logs\",`TC001-homepage-timeout-${timestamp}.xml`);const screenshotPath=(0,import_node_path.join)(process.cwd(),\"logs\",`TC001-homepage-timeout-${timestamp}.png`);console.error(\"[TC-001] Homepage readiness diagnostics:\",JSON.stringify({homeTabDisplayed:homeVisible,homeLabelInPageSource:homeLabelVisible,feedDisplayed:feedVisible,mainContainerDisplayed:containerVisible,contentLoadErrorDisplayed:contentErrorVisible,homepageReady:!contentErrorVisible&&homeVisible&&homeLabelVisible&&(feedVisible||containerVisible),pageSourceError:sourceError}));try{await(0,import_promises.writeFile)(pageSourcePath,source,\"utf8\");console.error(\"[TC-001] Homepage timeout page source saved:\",pageSourcePath)}catch(error){console.error(\"[TC-001] Could not save homepage timeout page source:\",error.message)}try{await browser.saveScreenshot(screenshotPath);console.error(\"[TC-001] Homepage timeout screenshot saved:\",screenshotPath)}catch(error){console.error(\"[TC-001] Could not save homepage timeout screenshot:\",error.message)}throw waitError}const bottomNav=await $('//*[@resource-id=\"com.cnn.mobile.android.phone:id/bottom_navigation\"]');const bottomNavVisible=await bottomNav.isDisplayed().catch(()=>false);console.log(\"[TC-001] Bottom nav visible:\",bottomNavVisible);await expect(homeTab).toBeDisplayed();const homepageSurfaceVisible=await mainContainer.isDisplayed().catch(()=>false)||await contentFeed.isDisplayed().catch(()=>false);expect(homepageSurfaceVisible).toBe(true);const pageSource=await driver.getPageSource();expect(pageSource).toContain(\"com.cnn.mobile.android.phone\");const contexts=await browser.getContexts();const webview=contexts.find(context=>context.startsWith(\"WEBVIEW_com.cnn\"));if(webview){try{await browser.switchContext(webview);const analyticsEvents=await browser.execute(()=>{return window.__wdioAnalyticsEvents||[]});console.log(\"[TC-001] Analytics events captured:\",JSON.stringify(analyticsEvents.slice(0,5)))}finally{await browser.switchContext(\"NATIVE_APP\")}}console.log(\"[TC-001] Homepage loaded successfully\")}","test_file_path":"/Users/edaley/Documents/WebDriverIO/scripts/wdio-appium/test/specs/android/TC001_HomepageLoad.spec.js","test_location":"t