{
  "name": "wdio-appium",
  "type": "module",
  "devDependencies": {
    "@wdio/appium-service": "9.31.7",
    "@wdio/browserstack-service": "^9.35.2",
    "@wdio/cli": "9.31.7",
    "@wdio/local-runner": "9.31.7",
    "@wdio/mocha-framework": "9.31.7",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/visual-service": "^10.1.0",
    "appium-uiautomator2-driver": "^8.6.1"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.js",
    "wdio:androidbs": "set -a && source .env && set +a && wdio run ./config/wdio.androidbs.conf.js",
    "wdio:browserstack": "set -a && source .env && set +a && wdio run ./wdio.browserstack.conf.js",
    "wdio:browserstack:login": "set -a && source .env && set +a && wdio run ./wdio.browserstack.conf.js --spec test/specs/TC007_LoginFlowValid.spec.js",
    "wdio:browserstack:homepage": "set -a && source .env && set +a && wdio run ./wdio.browserstack.conf.js --spec test/specs/android/TC001_HomepageLoad.spec.js"
  }
}
